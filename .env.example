# Set environment variables in your Node hosting provider, or use node --env-file=.env server/index.js --production
PORT=3000
HOST=127.0.0.1
BOOKING_MODE=preview
# Required for BOOKING_MODE=live. The receiving service must deduplicate by Idempotency-Key
# and deliver requests to a restaurant-managed booking system or inbox.
# PUBLIC_ORIGIN=https://your-restaurant-domain.example
# BOOKING_WEBHOOK_URL=https://your-booking-service.example/requests
# BOOKING_WEBHOOK_TOKEN=
# DATA_DIR=/persistent/restaurant-data
